# ---------------------------------------------------------------
#  JARVIS settings
#  1. Make a copy of this file and name the copy exactly:  .env
#  2. Paste your OANDA details below (no quotes, no spaces)
#  3. Save, then start JARVIS with "Run JARVIS.bat"
#  Never share your .env file with anyone.
# ---------------------------------------------------------------

# Your OANDA API token (OANDA website > My Account > Manage API Access)
OANDA_API_KEY=paste-your-api-key-here

# Your account ID, looks like 101-001-1234567-001
OANDA_ACCOUNT_ID=paste-your-account-id-here

# "practice" for a demo account, "live" for a real-money account
OANDA_ENV=practice

# Port the dashboard runs on (leave as 3000 unless something else uses it)
PORT=3000
